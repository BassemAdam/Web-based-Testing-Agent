    {
      "id": "TC_SIGNIN_VALID_01",
      "name": "Valid sign-in navigates to dashboard",
      "description": "Covers the happy path of entering valid credentials on the login page and navigating to the index/dashboard page.",
      "tags": [
        "functional",
        "happy_path",
        "login",
        "navigation"
      ],
      "steps": [
        {
          "action": "navigate",
          "page_id": "page_0",
          "target": null,
          "details": "Open the login page URL"
        },
        {
          "action": "assert",
          "page_id": "page_0",
          "target": "input|||email|email name='email' type='email' | css='input[name=\"email\"]'",
          "details": "Email input is present and enabled"
        },
        {
          "action": "type",
          "page_id": "page_0",
          "target": "input|||email|email name='email' type='email' | css='input[name=\"email\"]'",
          "details": "user@example.com"
        },
        {
          "action": "type",
          "page_id": "page_0",
          "target": "input|||password|password name='password' type='password' | css='input[name=\"password\"]'",
          "details": "CorrectHorseBatteryStaple!"
        },
        {
          "action": "click",
          "page_id": "page_0",
          "target": "a|Login| | css='a[href=\"index.html\"]'",
          "details": "Click the Login anchor to submit and navigate"
        },
        {
          "action": "assert",
          "page_id": "page_1",
          "target": "a|RobotFrameworkTutorial.com Demo Admin Site| | css='a[href=\"index.html\"]'",
          "details": "Dashboard header/link is visible indicating successful navigation"
        }
      ],
      "covered_element_keys": [
        "page_0::input||",
        "page_0::input||",
        "page_0::a|Login| ",
        "page_1::a|RobotFrameworkTutorial.com Demo Admin Site| "
      ],
      "selectors": [
        {
          "element_key": "input|||email|email",
          "page_id": "page_0",
          "css_selector": "input[name=\"email\"]",
          "xpath": "//input[@name=\"email\"]",
          "description": "Email input used to enter the user's email"
        },
        {
          "element_key": "input|||email|email",
          "page_id": "page_0",
          "css_selector": "input[name=\"email\"]",
          "xpath": "//input[@name=\"email\"]",
          "description": "Password input used to enter the user's password"
        },
        {
          "element_key": "a|Login|",
          "page_id": "page_0",
          "css_selector": "a[href=\"index.html\"]",
          "xpath": "//a[contains(text(), 'Login')]",
          "description": "Login link used to submit credentials and navigate to the dashboard"
        },
        {
          "element_key": "a|RobotFrameworkTutorial.com Demo Admin Site|",
